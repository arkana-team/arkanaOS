#!/usr/bin/env python3
"""Remove build documentation while retaining end-user help and license texts."""

from pathlib import Path
import shutil
import sys


def is_within_root(root: Path, path: Path) -> bool:
    try:
        path.relative_to(root)
        path.resolve(strict=False).relative_to(root)
    except (OSError, RuntimeError, ValueError):
        return False
    return True


def main() -> None:
    if len(sys.argv) != 1:
        raise SystemExit(f"usage: {sys.argv[0]}")

    output_root = Path(__file__).resolve().parent / "output"
    if output_root.is_symlink():
        raise SystemExit("refusing to use a symlinked output directory")
    output_root = output_root.resolve(strict=False)
    root = output_root / "iso-root"
    if root.is_symlink():
        raise SystemExit("refusing to prune a symlinked ISO root")
    root = root.resolve(strict=False)
    if root.parent != output_root:
        raise SystemExit(f"refusing to prune an ISO root outside output: {root}")
    marker = root / ".arkana-iso-root"
    if root == Path("/") or marker.is_symlink() or not marker.is_file():
        raise SystemExit(f"refusing to prune an unmarked ISO root: {root}")
    if marker.read_text(encoding="utf-8") != "arkanaOS ISO root\n":
        raise SystemExit(f"refusing to prune an unrecognized ISO root: {root}")

    doc_root = root / "usr/share/doc"
    if not is_within_root(root, doc_root) or not doc_root.is_dir():
        raise SystemExit(f"documentation directory not found: {doc_root}")

    license_root = root / "usr/share/licenses/documentation"
    if not is_within_root(root, license_root):
        raise SystemExit(f"refusing to write licenses outside ISO root: {license_root}")
    license_prefixes = ("license", "copying", "copyright", "notice")
    copied_licenses = 0

    for source in doc_root.rglob("*"):
        if (
            not is_within_root(root, source)
            or not source.is_file()
            or source.is_symlink()
        ):
            continue
        if not source.name.lower().startswith(license_prefixes):
            continue

        destination = license_root / source.relative_to(doc_root)
        if not is_within_root(root, destination.parent) or not is_within_root(
            root, destination
        ):
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        copied_licenses += 1

    keep_docs = {"nscde", "rust", "cargo"}
    removed_docs = 0
    for entry in doc_root.iterdir():
        if not is_within_root(root, entry):
            continue
        if entry.name in keep_docs:
            continue
        if entry.is_dir() and not entry.is_symlink():
            shutil.rmtree(entry)
        else:
            entry.unlink()
        removed_docs += 1

    removed_caches = 0
    python_lib_root = root / "usr/lib"
    if not is_within_root(root, python_lib_root):
        python_roots = ()
    else:
        python_roots = python_lib_root.glob("python*")
    for python_root in python_roots:
        if not is_within_root(root, python_root):
            continue
        caches = list(python_root.rglob("__pycache__"))
        for cache in caches:
            if (
                is_within_root(root, cache)
                and cache.is_dir()
                and not cache.is_symlink()
            ):
                shutil.rmtree(cache)
                removed_caches += 1

    print(
        f"Removed {removed_docs} package documentation trees and "
        f"{removed_caches} Python bytecode caches; preserved "
        f"{copied_licenses} license notices, NsCDE help, and Rust/Cargo docs."
    )


if __name__ == "__main__":
    main()
