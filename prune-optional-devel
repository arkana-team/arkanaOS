def remove_path(root: Path, path: Path) -> bool:
    try:
        path.relative_to(root)
        path.parent.resolve(strict=False).relative_to(root)
    except (OSError, RuntimeError, ValueError):
        return False

    if path.is_symlink() or path.is_file():
        path.unlink()
        return True
    if path.is_dir():
        shutil.rmtree(path)
        return True
    return False


def main() -> None:
    if len(sys.argv) != 1:
        raise SystemExit(f"usage: {sys.argv[0]}")
    output_root = Path(__file__).resolve().parent / "output"
    if output_root.is_symlink():
        raise SystemExit("refusing to use a symlinked output directory")
    output_root = output_root.resolve(strict=False)
    root = output_root / "iso-root"
    if root.is_symlink():
        raise SystemExit("refusing to prune a symlinked ISO root")
    root = root.resolve(strict=False)
    if root.parent != output_root:
        raise SystemExit(f"refusing to prune an ISO root outside output: {root}")
    if not root.is_dir():
        raise SystemExit(f"ISO root is not a directory: {root}")
    marker = root / ".arkana-iso-root"
    if root == Path("/") or marker.is_symlink() or not marker.is_file():
        raise SystemExit(f"refusing to prune an unmarked ISO root: {root}")
    if marker.read_text(encoding="utf-8") != "arkanaOS ISO root\n":
        raise SystemExit(f"refusing to prune an unrecognized ISO root: {root}")

    removed = 0
    for relative in (*DIRECTORIES, *FILES):
        removed += remove_path(root, root / relative)
    for pattern in PATTERNS:
        for path in root.glob(pattern):
            removed += remove_path(root, path)
    marker.unlink()
    print(f"Removed {removed} optional development paths from {root}")


if __name__ == "__main__":
    main()
