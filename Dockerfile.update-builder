FROM rust:1.85-slim-bookworm AS arkup-build

ARG ARKUP_GIT_URL=https://github.com/debarkak/arkup.git
ARG ARKUP_GIT_REF=f9b433bafacd00d7f1a29541e81b303b999c4d65

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "$ARKUP_GIT_REF" \
    && git clone --filter=blob:none "$ARKUP_GIT_URL" /src/arkup \
    && git -C /src/arkup checkout --detach "$ARKUP_GIT_REF" \
    && test "$(git -C /src/arkup rev-parse HEAD)" = "$ARKUP_GIT_REF"

WORKDIR /src/arkup
ENV CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0
RUN cargo test --release --locked \
    && cargo build --release --locked

FROM python:3.11-slim-bookworm AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=arkup-build /src/arkup/target/release/arkup /usr/local/bin/arkup
COPY scripts/build-update-pack.py /usr/local/lib/arkana-update-builder/build-update-pack.py
RUN chmod 0755 /usr/local/bin/arkup \
    && chmod 0644 /usr/local/lib/arkana-update-builder/build-update-pack.py

ENTRYPOINT ["python3", "/usr/local/lib/arkana-update-builder/build-update-pack.py"]
